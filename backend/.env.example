# ===== 应用 =====
APP_NAME=zk-oa
ENVIRONMENT=development
DEBUG=false

# ===== 数据库 =====
# 本地开发用 SQLite（async），生产改为 PostgreSQL：
# DATABASE_URL=postgresql+asyncpg://oa:oa_password@localhost:5432/oa
DATABASE_URL=sqlite+aiosqlite:///./oa.db

# ===== JWT 双令牌 =====
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== 跨域（前端地址，逗号分隔，生产禁用通配符）=====
CORS_ORIGINS=http://localhost:5173

# ===== 日志级别 =====
LOG_LEVEL=INFO

# ===== 对象存储 =====
# 开发用 local（落盘 uploads 目录）；生产改 s3 并下发签名 URL（前端不变）
STORAGE_BACKEND=local
# 以下仅在 STORAGE_BACKEND=s3 时生效（AWS S3 / 阿里云 OSS / MinIO 等 S3 兼容）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_REGION=us-east-1
S3_BUCKET=zk-oa
SIGNED_URL_EXPIRE_MINUTES=15

# ===== 后台调度（审批超时自动升级提醒）=====
# 默认关闭；生产按需开启，建议配合 PostgreSQL 与监控告警
SCHEDULER_ENABLED=false
# 调度轮询间隔（秒）
SCHEDULER_INTERVAL_SECONDS=300
# 流程实例从发起起算的 SLA 天数，超过且仍在 running 即触发升级通知
WORKFLOW_SLA_DAYS=3
# 超时处理策略：notify=仅通知 admin/manager；escalate=通知并自动转交至兜底角色审批人
WORKFLOW_TIMEOUT_ACTION=notify
# 自动转交时的兜底审批人角色（仅 escalate 策略生效）
WORKFLOW_TIMEOUT_FALLBACK_ROLE=admin

# ===== 轻量限流（每分钟每 IP 最大请求数，0 关闭）=====
RATE_LIMIT_PER_MINUTE=0

# ===== 实时推送（SSE）=====
# 心跳间隔（秒）：必须小于网关/代理的空闲超时，否则长连接会被误断
SSE_HEARTBEAT_SECONDS=25

# ===== 优雅停机 =====
# 收到终止信号后，等待在途请求完成的最长时间（秒），超时则记录告警并退出
GRACEFUL_SHUTDOWN_TIMEOUT_SECONDS=15
