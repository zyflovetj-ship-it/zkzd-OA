    </div></div>
    <div class="ft" style="z-index:2;" data-page-node-id="cpNvQBoXIRJy8No6BOnQ9S"><span data-page-node-id="HEvkdCQKm2zAvt7RnQuQoe">CONFIDENTIAL · 内部资料</span><span class="prog" data-page-node-id="w12NGKW7PJFMrCG1BBOCm4"><i style="width:7%" data-page-node-id="CPNLrEC1yXsrD0V6ccDbch"></i></span><span data-page-node-id="eDu9Aorp5zALXMAVYH9nbk">COVER · 00/15</span></div>
  </section>

  <!-- P01 目录 -->
  <section class="slide" data-page-node-id="t2X4aqhhxZTafXJO1XKd2o">
    <div class="hd" data-page-node-id="zUxyyPnijqlBX1OKXU4xSD"><div class="hl" data-page-node-id="tvdcBZhwiqCx2k8vzdy195"><div class="eyebrow" data-page-node-id="mX1w1ef2KSsuyDk6vtfxsk">CONTENTS · 汇报大纲</div><h2 class="ptitle" data-page-node-id="tnmYaOGb8c7IwipgdN99q5">全篇导航 · 两大板块 10 个主题</h2></div>
      <div class="hr" data-page-node-id="Ce6iqtwbNfo65CYc9mEyRn"><span class="tag" data-page-node-id="ZnVIIQXV84pRGtezQFIKHB">目录</span><span class="lamp" data-page-node-id="vCPLP4RxU26pDaVQmwInnB"></span><span class="pgnum" data-page-node-id="d8MSfOyFv13hbAN0VXjFFz">01 / 15</span></div></div>
    <div class="ct" data-page-node-id="yrXWiCMDh4WwqE88L9C6sq"><div class="wrap" data-page-node-id="P9s4vGTe5nfDviqTJE25BX">
