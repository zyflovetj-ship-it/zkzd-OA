<!DOCTYPE html>
<html lang="zh-CN" data-page-node-id="J3iyb3DuazH8C8i5t6BtAn">
<head data-page-node-id="zWlkqEJq7ZJFojyBs0ctrV">
<meta charset="UTF-8" data-page-node-id="xt6aT34vA1AYyFGuV5Z5wb">
<meta name="viewport" content="width=device-width, initial-scale=1.0" data-page-node-id="Qk0CyQX1TIVyP6rWucHqL2">
<title>中科智电 OA 系统 · 架构引擎与全流程汇报</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;700;900&family=Rajdhani:wght@500;600;700&display=swap');

/* ============ Tc · dark-luxury 专属模板（能源/AI 适配） ============ */
:root{
  --bg:#eef4fb; --card:#ffffff;
  --p:#0b7bc4; --pm:rgba(11,123,196,0.12); --bd:rgba(11,123,196,0.22);
  --t:#0b2f5c; --mt:#3f5b78; --dt:#8199b0;
  --c1:var(--p); --c2:#e08a00; --c3:#0f9d6f;
  --danger:#ef4444; --warning:#b45309; --success:#0f9d6f; --info:#0b7bc4; --neutral:#64748b;
  --font-display:'Rajdhani','Noto Sans SC',sans-serif;
  --font-body:'Noto Sans SC','Rajdhani',sans-serif;
  --font-mono:'Rajdhani',monospace;
}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0;}
html,body{width:100%;height:100%;overflow:hidden;background:#dce8f5;font-family:var(--font-body);color:var(--t);}

.stage{position:fixed;inset:0;display:flex;align-items:center;justify-content:center;}
.deck{position:relative;width:1280px;height:720px;transform-origin:center center;
  border-radius:10px;overflow:hidden;box-shadow:0 24px 90px rgba(11,47,92,.22),0 0 0 1px rgba(11,123,196,.14);}

.slide{position:absolute;inset:0;width:1280px;height:720px;overflow:hidden;
  display:flex;flex-direction:column;background:var(--bg);
  opacity:0;visibility:hidden;transition:opacity .45s ease, transform .45s cubic-bezier(.4,0,.2,1);transform:scale(.985);}
.slide.active{opacity:1;visibility:visible;transform:scale(1);z-index:2;}
.slide::before{content:'';position:absolute;inset:0;pointer-events:none;z-index:0;
  background:
    radial-gradient(900px 520px at 12% -8%, rgba(11,123,196,.16), transparent 60%),
    radial-gradient(820px 480px at 96% 4%, rgba(217,119,6,.12), transparent 60%),
    radial-gradient(760px 560px at 88% 104%, rgba(5,150,105,.10), transparent 60%),
    linear-gradient(180deg, rgba(238,244,251,0) 60%, rgba(11,123,196,.05) 100%);}
.slide::after{content:'';position:absolute;inset:0;pointer-events:none;z-index:0;opacity:.7;
  background:
    linear-gradient(180deg, rgba(11,123,196,.07), transparent 20%),
    repeating-linear-gradient(0deg, rgba(11,47,92,.042) 0 1px, transparent 1px 46px),
    repeating-linear-gradient(90deg, rgba(11,47,92,.042) 0 1px, transparent 1px 46px);}
.slide>*{position:relative;z-index:1;}

.hd{height:72px;padding:0 32px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;
  border-bottom:1px solid rgba(11,47,92,.06);
  background:linear-gradient(90deg, rgba(11,123,196,.06), transparent 55%);}
.hl{display:flex;flex-direction:column;gap:2px;position:relative;padding-left:11px;}
.hl::before{content:'';position:absolute;left:0;top:3px;bottom:3px;width:2px;border-radius:2px;
  background:linear-gradient(180deg,var(--p),transparent);}
.eyebrow{font-size:9.5px;letter-spacing:2px;color:var(--p);text-transform:uppercase;font-family:var(--font-mono);font-weight:600;}
.ptitle{font-size:18px;font-weight:900;color:var(--t);letter-spacing:.5px;}
.hr{display:flex;align-items:center;gap:9px;}
.tag{background:var(--pm);border:1px solid var(--bd);color:var(--p);font-size:9px;letter-spacing:1px;
  padding:3px 8px;border-radius:10px;font-family:var(--font-mono);font-weight:600;text-transform:uppercase;}
.lamp{width:5px;height:5px;border-radius:50%;background:var(--p);box-shadow:0 0 8px var(--p);}
.pgnum{font-size:16px;font-family:var(--font-mono);color:var(--p);font-weight:700;letter-spacing:1px;}

.ct{height:580px;padding:0 32px;overflow:hidden;flex-shrink:0;}
.wrap{height:calc(580px - 8px);padding-top:8px;display:flex;flex-direction:column;gap:8px;}

.sm{height:48px;padding:0 32px;display:flex;align-items:center;gap:10px;flex-shrink:0;
  background:rgba(11,47,92,.05);border-top:1px solid rgba(11,47,92,.05);}
.smbar{width:3px;height:24px;border-radius:2px;background:var(--p);box-shadow:0 0 10px var(--p);flex-shrink:0;}
.smtext{font-size:11px;color:var(--mt);line-height:1.3;}
.smtext b{color:var(--t);font-weight:700;}
.smspacer{flex:1;}
.chip{background:var(--pm);border:1px solid var(--bd);color:var(--p);font-size:9px;padding:3px 8px;
  border-radius:10px;font-family:var(--font-mono);white-space:nowrap;}

.ft{height:20px;padding:0 32px;display:flex;align-items:center;justify-content:space-between;flex-shrink:0;
  font-size:9px;color:var(--dt);font-family:var(--font-mono);letter-spacing:.5px;}
.prog{width:110px;height:3px;background:rgba(11,47,92,.08);border-radius:2px;overflow:hidden;}
.prog i{display:block;height:100%;background:linear-gradient(90deg,var(--p),var(--c3));border-radius:2px;}

.grid{display:grid;gap:8px;}
.g2{grid-template-columns:repeat(2,1fr);} .g3{grid-template-columns:repeat(3,1fr);}
.g4{grid-template-columns:repeat(4,1fr);} .g5{grid-template-columns:repeat(5,1fr);}
.g6{grid-template-columns:repeat(6,1fr);}
.card{background:var(--card);border:1px solid var(--bd);border-radius:7px;position:relative;overflow:hidden;box-shadow:0 2px 10px rgba(11,47,92,.06);
  padding:8px 10px;display:flex;flex-direction:column;gap:5px;min-height:0;}
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;
  background:linear-gradient(90deg,var(--p),transparent);}
.ch{font-size:12.5px;font-weight:700;color:var(--t);display:flex;align-items:center;gap:6px;flex-shrink:0;}
.ch .ic{width:22px;height:22px;border-radius:5px;background:var(--pm);border:1px solid var(--bd);
  display:flex;align-items:center;justify-content:center;font-size:11px;color:var(--p);font-family:var(--font-mono);font-weight:700;flex-shrink:0;}
.cb{font-size:11px;line-height:1.45;color:var(--mt);flex:1;overflow:hidden;}
.cb b{color:var(--t);font-weight:700;}
.cb em{color:var(--p);font-style:normal;font-family:var(--font-mono);}
.chiprow{display:flex;flex-wrap:wrap;gap:4px;flex-shrink:0;}
.chiprow span{font-size:9px;color:var(--mt);background:rgba(11,47,92,.05);border:1px solid rgba(11,47,92,.08);
  padding:2px 6px;border-radius:4px;font-family:var(--font-mono);}
.num-row{display:grid;gap:5px;flex-shrink:0;margin-top:auto;}
.numb{background:var(--pm);border:1px solid var(--bd);border-radius:4px;padding:4px 6px;text-align:center;}
.numb .nv{font-size:16px;font-weight:700;color:var(--p);font-family:var(--font-display);line-height:1.1;}
.numb .nl{font-size:8.5px;color:var(--dt);margin-top:1px;}
.accent{background:linear-gradient(120deg,var(--p),#0ea5e9);border-color:transparent;}
.accent .ch,.accent .cb,.accent .cb b{color:#04121f;}
.accent .cb em{color:#04121f;}
.accent::before{background:linear-gradient(90deg,rgba(255,255,255,.62),transparent);}
.accent .chiprow span{background:rgba(255,255,255,.22);border-color:rgba(255,255,255,.45);color:#04263f;}

.arch{display:flex;flex-direction:column;gap:7px;}
.layer{display:flex;align-items:stretch;gap:9px;border-radius:6px;padding:7px 10px;
  border:1px solid var(--bd);background:rgba(11,47,92,.02);position:relative;}
.layer .lab{width:118px;flex-shrink:0;display:flex;flex-direction:column;justify-content:center;}
.layer .lab .len{font-size:9px;font-family:var(--font-mono);letter-spacing:1px;color:var(--p);font-weight:700;}
.layer .lab .lcn{font-size:12px;font-weight:700;color:var(--t);}
.layer .cells{flex:1;display:flex;gap:7px;flex-wrap:wrap;align-items:center;}
.layer .cells .cell{flex:1;min-width:0;text-align:center;font-size:10px;color:var(--mt);
  background:rgba(11,47,92,.05);border:1px solid rgba(11,47,92,.09);border-radius:5px;padding:6px 4px;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-weight:500;}
.layer.l1{border-color:rgba(11,123,196,.35);background:rgba(11,123,196,.07);}
.layer.l2{border-color:rgba(217,119,6,.3);background:rgba(217,119,6,.06);}
.layer.l3{border-color:rgba(5,150,105,.3);background:rgba(5,150,105,.06);}
.layer.l4{border-color:rgba(109,40,217,.3);background:rgba(109,40,217,.06);}
.layer.l5{border-color:rgba(100,116,139,.28);background:rgba(100,116,139,.05);}
.layer.l2 .lab .len{color:var(--c2);} .layer.l3 .lab .len{color:var(--c3);}
.layer.l4 .lab .len{color:#6d28d9;} .layer.l5 .lab .len{color:var(--neutral);}
.arrowdown{text-align:center;color:var(--dt);font-size:10px;height:6px;line-height:0;}
.arch .layer{flex:1;min-height:0;}
.ct svg{min-height:0;}

.tbl{width:100%;border-collapse:collapse;font-size:10.5px;}
.tbl th{background:var(--pm);color:var(--p);font-size:9.5px;letter-spacing:.5px;text-transform:uppercase;
  padding:6px 8px;text-align:left;border-bottom:1px solid var(--bd);font-family:var(--font-mono);font-weight:700;}
.tbl td{padding:5.5px 8px;border-bottom:1px solid rgba(11,47,92,.06);color:var(--mt);vertical-align:top;}
.tbl td b{color:var(--t);}
.tbl tr:last-child td{border-bottom:none;}
.st{font-family:var(--font-mono);font-size:9.5px;font-weight:700;padding:2px 7px;border-radius:9px;white-space:nowrap;}
.st.ok{color:var(--success);background:rgba(5,150,105,.12);border:1px solid rgba(5,150,105,.3);}
.st.mid{color:var(--warning);background:rgba(180,83,9,.12);border:1px solid rgba(180,83,9,.3);}
.st.plan{color:var(--neutral);background:rgba(100,116,139,.12);border:1px solid rgba(100,116,139,.3);}

.kpi{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;flex-shrink:0;}
.kpi .k{background:var(--card);border:1px solid var(--bd);border-radius:7px;padding:8px 10px;position:relative;overflow:hidden;}
.kpi .k::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;background:linear-gradient(90deg,var(--p),transparent);}
.kpi .kv{font-size:26px;font-weight:700;color:var(--p);font-family:var(--font-display);line-height:1;}
.kpi .kl{font-size:9.5px;color:var(--dt);margin-top:3px;}

.tl{display:flex;gap:8px;align-items:stretch;flex:1;}
.tlnode{flex:1;background:var(--card);border:1px solid var(--bd);border-radius:7px;padding:9px 10px;
  display:flex;flex-direction:column;gap:6px;position:relative;}
.tlnode::before{content:'';position:absolute;top:0;left:0;bottom:0;width:3px;border-radius:7px 0 0 7px;background:var(--p);}
.tlnode .tn{font-size:10px;font-family:var(--font-mono);color:var(--p);font-weight:700;letter-spacing:1px;}
.tlnode .tt{font-size:12px;font-weight:700;color:var(--t);}
.tlnode .td{font-size:10.5px;color:var(--mt);line-height:1.45;flex:1;}

.cover .hd,.cover .sm{display:none;}
.cover .ct{height:700px;}
.covline{height:2px;background:linear-gradient(90deg,transparent,var(--p),transparent);}
.covwrap{height:700px;display:flex;flex-direction:column;justify-content:center;padding:0 92px;position:relative;}
.coveyebrow{display:flex;align-items:center;gap:14px;color:var(--p);font-size:10px;letter-spacing:4px;
  text-transform:uppercase;font-family:var(--font-mono);font-weight:600;}
.coveyebrow::before,.coveyebrow::after{content:'';height:1px;background:var(--bd);flex:0 0 40px;}
.covtitle{font-size:52px;font-weight:900;line-height:1.08;margin:20px 0 0;letter-spacing:1px;
  background:linear-gradient(120deg,#0b2f5c 30%,var(--p));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.covtitle small{display:block;font-size:26px;font-weight:700;color:var(--mt);-webkit-text-fill-color:var(--mt);margin-top:12px;letter-spacing:2px;}
.covsub{font-size:13px;color:var(--mt);margin-top:20px;max-width:620px;line-height:1.7;}
.covmeta{font-size:10.5px;color:var(--dt);margin-top:26px;display:flex;gap:14px;font-family:var(--font-mono);letter-spacing:1px;}
.covmeta span{display:flex;align-items:center;gap:14px;}
.covmeta span:not(:last-child)::after{content:'';width:4px;height:4px;border-radius:50%;background:var(--dt);}
.covtag{position:absolute;right:92px;top:50%;transform:translateY(-50%);text-align:right;font-family:var(--font-mono);}
.covtag .big{font-size:88px;font-weight:700;color:rgba(11,123,196,.16);line-height:1;}
.covtag .sm2{font-size:11px;color:var(--dt);letter-spacing:2px;}

.divider .hd,.divider .sm{display:none;}
.divider .ct{height:700px;}
.divwrap{height:700px;display:flex;flex-direction:column;justify-content:center;padding:0 92px;position:relative;overflow:hidden;}
.divghost{position:absolute;right:30px;bottom:-40px;font-size:300px;font-weight:900;color:rgba(11,47,92,.055);
  font-family:var(--font-display);line-height:1;}
.diveyebrow{display:flex;align-items:center;gap:12px;color:var(--p);font-size:10px;letter-spacing:4px;
  text-transform:uppercase;font-family:var(--font-mono);font-weight:600;}
.divnum{font-size:76px;font-weight:700;line-height:1;font-family:var(--font-display);
  background:linear-gradient(120deg,#0b2f5c,var(--p));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;}
.divname{font-size:34px;font-weight:900;color:var(--t);margin-top:4px;letter-spacing:1px;}
.divdesc{font-size:12.5px;color:var(--mt);margin-top:16px;max-width:460px;line-height:1.7;}

.toc{display:grid;grid-template-columns:1fr 1fr;gap:8px;flex:1;align-content:start;}
.tocitem{display:flex;align-items:center;gap:10px;background:var(--card);border:1px solid rgba(11,47,92,.07);
  border-radius:7px;padding:9px 12px;}
.tocitem .no{font-size:22px;font-weight:700;font-family:var(--font-display);color:var(--p);opacity:.5;min-width:34px;}
.tocitem .tt{flex:1;}
.tocitem .tt .k{font-size:8.5px;letter-spacing:1px;color:var(--dt);text-transform:uppercase;font-family:var(--font-mono);}
.tocitem .tt .n{font-size:12px;font-weight:600;color:var(--t);}
.tocitem .pg{font-family:var(--font-mono);font-size:11px;color:var(--dt);}

.nav{position:fixed;bottom:12px;left:50%;transform:translateX(-50%);display:flex;align-items:center;gap:14px;z-index:50;
  background:transparent;border:none;box-shadow:none;backdrop-filter:none;padding:2px 6px;
  pointer-events:none;filter:drop-shadow(0 1px 3px rgba(11,47,92,.5));}
.nav button,.nav .dots,.nav .dots i,.nav .counter{pointer-events:auto;}
.nav button{background:none;border:none;color:var(--p);font-size:15px;cursor:pointer;font-family:var(--font-body);
  padding:2px 6px;border-radius:4px;transition:.2s;}
.nav button:hover{background:var(--pm);}
.nav button:disabled{color:var(--dt);cursor:default;background:none;}
.dots{display:flex;gap:5px;}
.dots i{width:6px;height:6px;border-radius:50%;background:rgba(11,47,92,.16);cursor:pointer;transition:.25s;}
.dots i.on{background:var(--p);box-shadow:0 0 7px var(--p);width:16px;border-radius:3px;}
.counter{font-family:var(--font-mono);font-size:11px;color:var(--mt);min-width:44px;text-align:center;}
.hint{position:fixed;top:16px;right:20px;font-size:10px;color:var(--dt);z-index:50;font-family:var(--font-mono);letter-spacing:1px;}
</style>
</head>
