# ============================================================
# zk-oa 生产部署环境变量（docker compose 读取根目录 .env）
#
# 用法：
#   cp .env.example .env
#   然后填写下面三个「必填」项
#
# 前 3 项缺失时 docker compose 会直接报错退出，不会静默产出坏部署。
# ============================================================

# ---------- 必填 1：JWT 签名密钥 ----------
# 生成：python3 -c 'import secrets;print(secrets.token_hex(32))'
# 生产环境若仍是弱值，后端启动即失败（config.py 的快速失败机制）
JWT_SECRET=

# ---------- 必填 2：浏览器可达的后端地址 ----------
# 注意：这是【用户浏览器】发起请求的地址，不是容器内地址。
# 填 localhost 会导致远程用户去连他们自己电脑的 8000 端口，前端表现为全白/请求失败。
# 示例：http://192.168.1.10:8000  或  https://oa-api.example.com
# ⚠️ 该值在构建期内联进前端产物，改完必须重建：docker compose up -d --build frontend
VITE_API_BASE=

# ---------- 必填 3：前端访问地址（后端 CORS 白名单）----------
# 示例：http://192.168.1.10:5173  或  https://oa.example.com
# 多个来源用英文逗号分隔，不要写通配符 *
CORS_ORIGINS=

# ============================================================
# 以下为可选项，不填则使用默认值
# ============================================================

# PostgreSQL 口令（默认 oa_password）
# 生产建议改强口令；注意改之前要确认数据卷为空，否则旧库仍是旧口令
# POSTGRES_PASSWORD=

# 附件存储后端：local（默认，落 oa_uploads 卷）| s3
# 改 s3 时必须同时提供 AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / S3_BUCKET，
# 否则后端启动失败（config.py 会校验）
# STORAGE_BACKEND=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT_URL=
# S3_REGION=us-east-1
# S3_BUCKET=

# 轻量限流：每 IP 每分钟最大请求数，0 为关闭（默认 0）
# 公网暴露时建议开启，例如 300
# RATE_LIMIT_PER_MINUTE=0

# 审批超时自动升级（默认关闭）
# SCHEDULER_ENABLED=false
# WORKFLOW_SLA_DAYS=3
# WORKFLOW_TIMEOUT_ACTION=notify
