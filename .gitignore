# ===== 依赖（体积大且平台相关，不入库）=====
node_modules/
.venv/
venv/
*.egg-info/

# ===== 构建产物 =====
dist/
.test-build/
*.tsbuildinfo

# ===== Python 运行期产物 =====
__pycache__/
*.py[cod]
.pytest_cache/

# ===== 本地开发数据库 =====
*.db
*.sqlite
*.sqlite3

# ===== 本地上传目录（生产应挂卷或走 S3）=====
backend/uploads/

# ===== 日志 =====
*.log

# ===== 环境变量（含密钥，绝不入库；示例文件保留）=====
.env
.env.*
!.env.example

# ===== 编辑器 / 系统 =====
.DS_Store
.vscode/
.idea/
*.swp

# ===== 临时目录 =====
.npm-tmp/
.eval-rollup/
